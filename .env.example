# Copy to `.env` in the repository root and fill in values.

# --- Frontend (Vite; exposed to the browser only with VITE_ prefix) ---
# URL of the Express API. Local dev: your machine. Single Vercel project: omit so the app uses the same hostname.
# VITE_BACKEND_URL=http://127.0.0.1:3002
# Python FastAPI burn classifier (default port 8000).
VITE_BURN_MODEL_API=http://127.0.0.1:8000

# Injected at build time for the Gemini client (keep secret; do not commit real keys).
GEMINI_API_KEY=

# --- Backend (Node / Express) ---
BACKEND_PORT=3002
# Required in production. First registered user becomes admin in dev JSON store.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Optional: Google Places text search for `/api/places/nearby` (falls back to Overpass + static list).
GOOGLE_MAPS_API_KEY=
# Alternative names also supported in code: GOOGLE_PLACES_API_KEY, MAPS_API_KEY

# --- Python model (see burn_model_api/) ---
# BURN_MODEL_WEIGHTS=path\to\best_burn_model_v4.pth
